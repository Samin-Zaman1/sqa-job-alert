  "filters": {
    "_help": "strong_title: unambiguous software-testing titles (SQA, SDET, QA Engineer, Software Engineer in Test, Functional Tester, UAT Analyst, Playwright/Selenium/Cypress...), always kept. weak_title: vague titles (QA Executive, Quality Engineer, QC Engineer, Tester...), kept only on a company careers page, in Bdjobs' IT category, or when the company name matches tech_company. exclude: industry words (garments, pharma, lab, PLC, call center...) that drop a job: checked in the title, and in the company name for weak matches.",
    "strong_title": "\\b(sdet|s\\.?q\\.?a|qae|qe|software (?:quality|test|testing|tester|testers|qa|qc)\\w*|(?:q\\.?a\\.?|q\\.?e\\.?)[ -]?(?:engineer|tester|lead|analyst|automation|manual|architect|intern|trainee|consultant|developer)s?|(?:automation|automated|manual|mobile|app|game|games|api|performance|load|stress|security|web|website|ui|functional|regression|integration|e2e|end[- ]to[- ]end|usability|accessibility|localization|localisation|beta|bug|android|ios|frontend|backend|embedded|firmware|data|etl|blockchain|smart contract) (?:qa|qe|tester|testers|testing|test engineer|test analyst)|test(?:ing)? (?:engineer|automation|analyst|lead|manager|architect|specialist|consultant|developer|intern|trainee|coordinator)s?|automation (?:test|qa|qe|testing|tester)\\w*|quality assurance (?:automation|tester|analyst|engineer)|(?:software |developer |engineer |engineering )in test|uat (?:engineer|analyst|tester|specialist|lead|coordinator)|quality engineer(?:ing)?[\\s(-]*(?:software|automation|qa|test)|qa ?/ ?(?:sqa|qe|testing)|sqa ?/ ?qa|selenium|playwright|cypress|appium|katalon|jmeter|gatling|loadrunner|webdriverio|robot framework|testcomplete|ranorex|tosca|xcuitest|testng|cucumber|istqb|ctfl)\\b",
    "weak_title": "\\b(q\\.?a|qc (?:engineer|tester|analyst)|quality assurance|quality engineer\\w*|quality analyst|tester|testers|testing|automation engineer|uat)\\b",
    "tech_company": "\\b(it|ict|software|soft|tech|techno|technology|technologies|solutions?|digital|fintech|systems?|labs?|apps?|bpo|ai|cloud|saas|web|data|cyber|telecom|interactive|studios?|games?|infotech|innovations?|computing|networks?|platforms?|limited \\(it\\))\\b",
    "exclude": "\\b(garments?|textiles?|knit|knitting|denim|apparel|fabric|dyeing|washing|sewing|sweaters?|woven|fashion|food|foods|pharma|pharmaceuticals?|chemist|chemicals?|medical|diagnostics|hospital|civil|construction|welding|electrical|mechanical|lab|laborator(?:y|ies)|leather|footwear|plastic|packaging|cement|steel|feed|tea|merchandis\\w*|qa/qc|qc/qa|qc ?& ?qa|qa ?& ?qc|qa-qc|qc-qa|buying house|supplier|plc|scada|instrumentation|industrial|hvac|rpa|call cent(?:er|re)|contact cent(?:er|re)|customer (?:service|care)|marketing automation|ndt|dairy|poultry|cosmetics?|toiletries|printing|yarn|spinning|accessories|trims|ceramics?|glass|paint|beverage|bakery|frozen|seafood|agro|fertilizer|automobile|automotive|vehicle|tyre|battery|cable|power plant|substation|generator|transformer|rmg|sample|embroidery|audit|auditor|raters?|annotators?|inspection|inspectors?)\\b",
    "skip_level": "\\b(junior|jr|entry[- ]level|associate|graduate|fresher|manager|head|director|vp|vice president)\\b"
  },
  "fit": {
    "_help": "Scores how well each job matches your CV (Playwright/TypeScript, API testing, automation, SaaS; ~3 years). Each term found in the title, experience or description adds its weight; best fits sort first on the board.",
    "terms": [
      {"label": "Playwright", "pattern": "\\bplaywright\\b", "weight": 4},
      {"label": "TypeScript", "pattern": "\\btypescript\\b", "weight": 3},
      {"label": "JavaScript/Node", "pattern": "\\bjavascript\\b|\\bnode(?:\\.?js)?\\b", "weight": 1},
      {"label": "API testing", "pattern": "\\bapis?\\b|rest ?api|restful|postman|swagger|openapi", "weight": 2},
      {"label": "Automation", "pattern": "\\bautomat\\w+|\\bsdet\\b|engineer in test", "weight": 2},
      {"label": "CI/CD", "pattern": "github actions|\\bci ?/ ?cd\\b|continuous integration", "weight": 1},
      {"label": "SaaS/web", "pattern": "\\bsaas\\b|\\bweb app\\w*", "weight": 1},
      {"label": "UAT/regression", "pattern": "\\buat\\b|\\bregression\\b", "weight": 1},
      {"label": "Load testing", "pattern": "load test\\w*|performance test\\w*|\\bk6\\b|jmeter", "weight": 1},
      {"label": "Java", "pattern": "\\bjava\\b", "weight": -2},
      {"label": "C#/.NET", "pattern": "c#|\\.net\\b", "weight": -2},
      {"label": "Mobile", "pattern": "\\bappium\\b|\\bios\\b|\\bandroid\\b|mobile app", "weight": -1},
      {"label": "Platform-specific", "pattern": "\\b(sap|salesforce|servicenow|pega|guidewire|dynamics 365)\\b", "weight": -3},
      {"label": "Hardware/embedded", "pattern": "\\bembedded\\b|firmware|hardware|\\bkernel\\b|automotive", "weight": -3},
      {"label": "Other language required", "pattern": "(?:fluent|native|proficien\\w*)[^.]{0,40}\\b(german|french|spanish|dutch|japanese|portuguese|italian|polish|arabic)\\b|\\(m/[fw]/d\\)", "weight": -3},
      {"label": "5+ years asked", "pattern": "(?<![-\\u2013\\d] )(?<![-\\u2013\\d])(?<!to )\\b(?:[5-9]|1[0-9])\\s*\\+?\\s*(?:years|yrs)", "weight": -2}
    ]
  },
  "dedupe": {
    "_help": "reposters: recruiter/aggregator accounts that re-post other companies' jobs under their own name. Their copy of a job already tracked (same title, same board) is treated as a duplicate.",
    "reposters": ["nextjobz"]
  },
